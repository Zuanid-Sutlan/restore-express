<#macro heroSection>
  <section class="hero" id="hero">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="badge"><i class="fa-solid fa-bolt"></i> Fast, Postal & In-Store Repair</div>
        <h1 class="hero-title">Fast & Reliable <span class="highlight">Mobile Phone</span> Repairs</h1>
        <p class="hero-desc">
          Professional smartphone diagnostics, high-grade parts replacement, and express turnaround. Mail your device or
          book online with total transparency and warranty guarantee.
        </p>
        <div class="hero-buttons">
          <a href="/repair/book" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-screwdriver-wrench"></i> Repair My Phone
          </a>
          <a href="/track" class="btn btn-outline btn-lg">
            <i class="fa-solid fa-magnifying-glass"></i> Track My Repair
          </a>
        </div>
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-num">50k+</span>
            <span class="stat-label">Phones Restored</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">24-48h</span>
            <span class="stat-label">Avg Turnaround</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num">12 Mo</span>
            <span class="stat-label">Warranty</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="visual-card">
          <div class="gradient-glow"></div>
          <img src="/static/images/hero-phone.jpg"
            alt="Smartphone repair concept" class="hero-phone-img"
            onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1592899677977-9c10ca588bbd?w=800&auto=format&fit=crop&q=80';" />
          <div class="floating-badge badge-top">
            <i class="fa-solid fa-circle-check"></i>
            <div>
              <strong>100% Tested</strong>
              <span>Multi-point QA check</span>
            </div>
          </div>
          <div class="floating-badge badge-bottom">
            <i class="fa-solid fa-truck-fast"></i>
            <div>
              <strong>Free Return Postal</strong>
              <span>Insured delivery</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</#macro>

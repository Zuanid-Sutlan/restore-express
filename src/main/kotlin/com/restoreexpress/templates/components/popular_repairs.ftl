<#macro popularRepairsSection>
  <section class="section popular-repairs" id="popular-repairs">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Comprehensive Solutions</span>
        <h2 class="section-title">Popular Repairs</h2>
        <p class="section-desc">Top quality hardware repairs for Apple iPhone, Samsung Galaxy, Google Pixel, and more.</p>
      </div>

      <div class="repairs-grid">
        <!-- Service 1 -->
        <div class="repair-card">
          <div class="repair-img-wrap">
            <img src="/static/images/screen-repair.jpg" alt="Screen Repair"
                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1580910051074-3eb694886505?w=600&auto=format&fit=crop&q=80';" />
            <span class="category-tag">Display</span>
          </div>
          <div class="repair-body">
            <h3>Screen Repair & Replacement</h3>
            <p>Fix cracked glass, unresponsive touch digitizers, and bleeding OLED/LCD panels.</p>
            <div class="repair-footer">
              <div class="price-box">
                <span class="price-from">Starts from</span>
                <span class="price-amount">$39.00</span>
              </div>
              <a href="/repair/book" class="btn btn-sm btn-primary">Book Now</a>
            </div>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="repair-card">
          <div class="repair-img-wrap">
            <img src="/static/images/battery-replacement.jpg" alt="Battery Replacement"
                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1609081219090-a6d81d3085bf?w=600&auto=format&fit=crop&q=80';" />
            <span class="category-tag">Power</span>
          </div>
          <div class="repair-body">
            <h3>Battery Replacement</h3>
            <p>Restore full day battery life with brand-new high capacity, zero-cycle battery cells.</p>
            <div class="repair-footer">
              <div class="price-box">
                <span class="price-from">Starts from</span>
                <span class="price-amount">$29.00</span>
              </div>
              <a href="/repair/book" class="btn btn-sm btn-primary">Book Now</a>
            </div>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="repair-card">
          <div class="repair-img-wrap">
            <img src="/static/images/charging-port.jpg" alt="Charging Port Repair"
                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1541807084-5c52b6b3adef?w=600&auto=format&fit=crop&q=80';" />
            <span class="category-tag">Hardware</span>
          </div>
          <div class="repair-body">
            <h3>Charging Port Repair</h3>
            <p>Resolve loose cables, slow charging, dust blockage, or failed USB-C/Lightning modules.</p>
            <div class="repair-footer">
              <div class="price-box">
                <span class="price-from">Starts from</span>
                <span class="price-amount">$34.00</span>
              </div>
              <a href="/repair/book" class="btn btn-sm btn-primary">Book Now</a>
            </div>
          </div>
        </div>

        <!-- Service 4 -->
        <div class="repair-card">
          <div class="repair-img-wrap">
            <img src="/static/images/camera-repair.jpg" alt="Camera Repair"
                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1512499617640-c74ae3a79d37?w=600&auto=format&fit=crop&q=80';" />
            <span class="category-tag">Optics</span>
          </div>
          <div class="repair-body">
            <h3>Camera Lens & Sensor Repair</h3>
            <p>Clear blurry shots, replace cracked lens protective glass, and calibrate optical stabilization.</p>
            <div class="repair-footer">
              <div class="price-box">
                <span class="price-from">Starts from</span>
                <span class="price-amount">$45.00</span>
              </div>
              <a href="/repair/book" class="btn btn-sm btn-primary">Book Now</a>
            </div>
          </div>
        </div>

        <!-- Service 5 -->
        <div class="repair-card">
          <div class="repair-img-wrap">
            <img src="/static/images/back-glass.jpg" alt="Back Glass Repair"
                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1565849904461-04a58ad377e0?w=600&auto=format&fit=crop&q=80';" />
            <span class="category-tag">Body</span>
          </div>
          <div class="repair-body">
            <h3>Back Glass Replacement</h3>
            <p>Laser precision rear glass removal and fitment to make your device look brand new.</p>
            <div class="repair-footer">
              <div class="price-box">
                <span class="price-from">Starts from</span>
                <span class="price-amount">$49.00</span>
              </div>
              <a href="/repair/book" class="btn btn-sm btn-primary">Book Now</a>
            </div>
          </div>
        </div>

        <!-- Service 6 -->
        <div class="repair-card">
          <div class="repair-img-wrap">
            <img src="/static/images/speaker-repair.jpg" alt="Speaker Repair"
                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1546868871-7041f2a55e12?w=600&auto=format&fit=crop&q=80';" />
            <span class="category-tag">Audio</span>
          </div>
          <div class="repair-body">
            <h3>Earpiece & Speaker Repair</h3>
            <p>Fix distorted audio, muffled call sound, microphonic buzzing, and stereo loudspeaker issues.</p>
            <div class="repair-footer">
              <div class="price-box">
                <span class="price-from">Starts from</span>
                <span class="price-amount">$25.00</span>
              </div>
              <a href="/repair/book" class="btn btn-sm btn-primary">Book Now</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</#macro>

<#macro whyChooseUsSection>
  <section class="section why-choose" id="why-choose-us">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Our Commitments</span>
        <h2 class="section-title">Why Choose <span class="highlight">Restore Express</span></h2>
        <p class="section-desc">Reliable service backed by certified repair engineers, genuine components, and guaranteed satisfaction.</p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-user-gear"></i></div>
          <h3>Certified Technicians</h3>
          <p>Highly qualified master engineers experienced with all major flagship and budget smartphones.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-shield-halved"></i></div>
          <h3>Genuine Parts</h3>
          <p>We source premium OEM-grade screens, original spec batteries, and certified internal components.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-stopwatch"></i></div>
          <h3>Fast Turnaround</h3>
          <p>Over 85% of repairs are completed within 24 hours of arrival at our central repair lab.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-lock"></i></div>
          <h3>Secure Payment</h3>
          <p>256-bit encrypted checkout supporting major cards, digital wallets, and no-fix-no-fee safety.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-location-crosshairs"></i></div>
          <h3>Repair Tracking</h3>
          <p>Real-time online portal tracking: intake, diagnostic, repair in progress, quality testing, dispatch.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-award"></i></div>
          <h3>Warranty Included</h3>
          <p>Up to 12 months comprehensive warranty covering parts and labor on every eligible repair.</p>
        </div>
      </div>
    </div>
  </section>
</#macro>

<#macro whyChooseUsSection>
  <section class="section why-choose" id="why-choose-us">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Commercial Trust & Provenance</span>
        <h2 class="section-title">Why Choose <span class="highlight">Restore Express</span> Auctions</h2>
        <p class="section-desc">Trusted by commercial buyers, tech resellers, and enterprise teams across the UK and Ireland.</p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-microchip"></i></div>
          <h3>100% Diagnostic Audits</h3>
          <p>Every single unit undergoes rigorous multi-point diagnostic testing before being listed in our marketplace catalog.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-shield-halved"></i></div>
          <h3>Guaranteed Provenance</h3>
          <p>Legally verified chain of custody with serial and IMEI verification against blacklisting or third-party liens.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-warehouse"></i></div>
          <h3>4 Central Regional Hubs</h3>
          <p>Distribution centers in Midlands, North, South, and Scotland ensuring fast pickup or insured courier dispatch.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-bolt"></i></div>
          <h3>Real-Time Bid Engine</h3>
          <p>Sub-second WebSocket bidding infrastructure with transparent bidding histories and automatic outbid notifications.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
          <h3>Insured Transit</h3>
          <p>Fully insured courier freight with trackable dispatch and ESD anti-static packaging on all hardware lots.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><i class="fa-solid fa-award"></i></div>
          <h3>Buyer Protection</h3>
          <p>30-day warranty coverage on eligible Grade A and Grade B lots, backed by certified diagnostic engineers.</p>
        </div>
      </div>
    </div>
  </section>
</#macro>
